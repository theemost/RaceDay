@model List<RaceDay.MVC.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";

    int eventId = (int)ViewBag.EventId;
    string eventName = ViewBag.EventName;
}

<div class="container mt-4">

    <h2>Manage Categories</h2>
    <h4 class="text-muted">@eventName</h4>

    <p>Add and manage categories for this event.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <a asp-controller="Categories"
       asp-action="Create"
       asp-route-eventId="@eventId"
       class="btn btn-primary mb-3">
        <i class="bi bi-plus-circle"></i>
        Add Category
    </a>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No categories have been added to this event yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-header">
                <h5 class="mb-0">Event Categories</h5>
            </div>

            <div class="card-body">

                <table class="table table-striped table-bordered">

                    <thead>
                        <tr>
                            <th>Category ID</th>
                            <th>Category Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CategoryId</td>
                                <td>@item.CategoryName</td>

                                <td>
                                    <a asp-controller="Categories"
                                       asp-action="Edit"
                                       asp-route-id="@item.CategoryId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <form asp-controller="Categories"
                                          asp-action="Delete"
                                          asp-route-id="@item.CategoryId"
                                          asp-route-eventId="@eventId"
                                          method="post"
                                          style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this category?');">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    }

    <a asp-controller="Events"
       asp-action="Details"
       asp-route-id="@eventId"
       class="btn btn-secondary mt-3">
        Back to Event
    </a>

</div>
