@model RaceDay.MVC.Models.EditEnrolmentViewModel

@{
    ViewData["Title"] = "Manage Enrolment";
}

<div class="container mt-4">

    <h2>Manage Enrolment</h2>

    <form asp-action="Edit" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="EnrolmentId" />
        <input type="hidden" asp-for="EventId" />
        <input type="hidden" asp-for="CategoryId" />

        <div class="mb-3">
            <label asp-for="EnrolmentId" class="form-label">
                Enrolment ID
            </label>

            <input asp-for="EnrolmentId"
                   class="form-control"
                   disabled />
        </div>

        <div class="mb-3">
            <label asp-for="EnrolmentStatus" class="form-label">
                Enrolment Status
            </label>

            <select asp-for="EnrolmentStatus" class="form-select">
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>

            <span asp-validation-for="EnrolmentStatus"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
