@model List<RaceDay.MVC.Models.EventType>

@{
    ViewData["Title"] = "Manage Event Types";
}

<div class="container mt-4">

    <h2>Manage Event Types</h2>

    <p class="text-muted">
        Create and manage the types of events available on RaceDay.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Add Event Type -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Add New Event Type</h5>
        </div>

        <div class="card-body">

            <form asp-controller="EventTypes"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row">

                    <div class="col-md-8">
                        <input type="text"
                               name="eventTypeName"
                               class="form-control"
                               placeholder="Enter event type name"
                               required />
                    </div>

                    <div class="col-md-4">
                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i>
                            Add Event Type
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Existing Event Types -->
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Available Event Types</h5>
        </div>

        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No event types have been created yet.
                </div>
            }
            else
            {
                <table class="table table-striped table-bordered">

                    <thead>
                        <tr>
                            <th>Event Type ID</th>
                            <th>Event Type Name</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.EventTypeId</td>
                                <td>@item.EventTypeName</td>
                            </tr>
                        }
                    </tbody>

                </table>
            }

        </div>
    </div>

    <a asp-controller="Organiser"
       asp-action="Dashboard"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>
