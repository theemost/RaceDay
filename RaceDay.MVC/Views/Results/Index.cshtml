@model List<RaceDay.MVC.Models.Result>

@{
    ViewData["Title"] = "Results";
    var isOrganiser = Context.Session.GetString("Role") == "Organiser";

    var eventGroups = Model
        .GroupBy(r => new { r.EventId, r.EventName })
        .OrderBy(g => g.Key.EventName);
}

<div class="container mt-4">

    <h2>@(isOrganiser ? "Manage Results" : "My Results")</h2>

    <p>View finishing times and positions organised by event and category.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (isOrganiser)
    {
        <a asp-controller="Results"
           asp-action="Create"
           class="btn btn-primary mb-3">
            <i class="bi bi-plus-circle"></i>
            Record Result
        </a>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No results are available yet.
        </div>
    }
    else
    {
        @foreach (var eventGroup in eventGroups)
        {
            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <h4 class="mb-0">
                        @eventGroup.Key.EventName
                    </h4>
                </div>

                <div class="card-body">

                    @{
                        var categoryGroups = eventGroup
                            .GroupBy(r => r.CategoryName)
                            .OrderBy(g => g.Key);
                    }

                    @foreach (var categoryGroup in categoryGroups)
                    {
                        <div class="mb-4">

                            <h5 class="mb-3">
                                @categoryGroup.Key
                            </h5>

                            <div class="table-responsive">

                                <table class="table table-striped table-bordered">

                                    <thead>
                                        <tr>
                                            <th>Position</th>

                                            @if (isOrganiser)
                                            {
                                                <th>Participant</th>
                                            }

                                            <th>Finishing Time</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var result in categoryGroup
                                            .OrderBy(r => r.Position)
                                            .ThenBy(r => r.FinishTime))
                                        {
                                            <tr>
                                                <td>
                                                    @if (result.Position == 1)
                                                    {
                                                        <strong>🥇 1st</strong>
                                                    }
                                                    else if (result.Position == 2)
                                                    {
                                                        <strong>🥈 2nd</strong>
                                                    }
                                                    else if (result.Position == 3)
                                                    {
                                                        <strong>🥉 3rd</strong>
                                                    }
                                                    else
                                                    {
                                                        @result.Position
                                                    }
                                                </td>

                                                @if (isOrganiser)
                                                {
                                                    <td>@result.ParticipantName</td>
                                                }

                                                <td>
                                                    @result.FinishTime.ToString(@"hh\:mm\:ss")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>

                                </table>

                            </div>
                        </div>
                    }

                </div>
            </div>
        }
    }

</div>
